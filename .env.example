# Copy this file to .env (never commit .env itself) and fill in your key.
#
# --- Keeping this key safe (beyond .gitignore) --------------------------
#   - On the OpenAI dashboard, create a project-scoped key for this repo
#     specifically (not your main/org key) and set a monthly spend limit +
#     email alert on it. A leaked key with a $5 cap does a lot less damage.
#   - Never print, log, or paste a full request/response object in a way
#     that could echo the key -- it's not IN the response, but don't get in
#     the habit of dumping raw client internals to stdout/screenshots.
#   - This file lives at chmod 600 (owner read/write only) -- keep it that
#     way; `chmod 600 .env` if you ever recreate it.
#   - A local git pre-commit hook (.git/hooks/pre-commit) now refuses any
#     commit that stages .env or a diff shaped like a live key, as a backstop
#     for the day you `git add -A` without looking. It's untracked (git
#     hooks always are) so it only protects this clone.
#   - If a key ever does leak (pushed, pasted, shared), revoke it on the
#     dashboard immediately and issue a new one -- don't just delete the commit.
# --------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Model tiering by roadmap week ---------------------------------------
# Same OPENAI_MODEL var throughout -- just edit this line as you move
# between weeks so early, high-iteration experiments don't burn budget on
# a frontier model you don't need yet. Prices below are confirmed per-1M-
# token rates (input / cached input / output), not guessed from tier names --
# the gpt-5.6-* family is NEWER but not cheaper than its gpt-5 equivalent,
# so this sticks with gpt-5/gpt-5-mini as long as they're supported.
#
#   Week 1-2 (fundamentals: tokens, temperature, streaming, structured
#             output)          -> gpt-5-nano    ($0.05 / $0.005 / $0.40)
#   Week 3-5 (RAG, agents,
#             tool use)        -> gpt-5-mini    ($0.25 / $0.025 / $2.00)
#   Week 6-8 (evals, multi-
#             agent, capstone) -> gpt-5.6-sol   ($4.00 / $0.40  / $20.00)
#             (no cheaper frontier-tier alternative was confirmed, so this
#             is the one model here from the newer family)
#
# Sanity-check what your account can actually call before trusting this:
#   python -c "from openai import OpenAI; [print(m.id) for m in OpenAI().models.list()]"
# gpt-5-nano/gpt-5-mini are scheduled to sunset 2026-12-11 -- re-check
# pricing/availability if you're still on Week 1-5 close to that date.
OPENAI_MODEL=gpt-5-nano

# --- Week 5: retrieval (both optional -- the defaults below apply if unset)
# Which vector store retrieval.py searches: "faiss" (Phase A, in-process)
# or "pgvector" (exercise 3 on, needs `docker compose up -d pgvector`).
# VECTOR_STORE=faiss
# Matches docker-compose.yml (local dev only, bound to 127.0.0.1).
# PGVECTOR_DSN=postgresql://copilot:copilot@127.0.0.1:5433/copilot
# FAISS_INDEX_DIR=faiss-recursive-500
